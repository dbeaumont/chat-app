{
  "uid": "jvm-http-hikari",
  "title": "Chat Backend • JVM + HTTP + Hikari",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP req/s (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (method, status) (rate(http_server_requests_seconds_count{uri!~\"/actuator/.*\"}[1m]))",
          "legendFormat": "{{method}} {{status}}",
          "datasource": { "type": "prometheus", "uid": "prom" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p50 / p95 / p99 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator/.*\"}[5m])))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "prom" }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator/.*\"}[5m])))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "prom" }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator/.*\"}[5m])))",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "prom" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Hikari connections (active / total)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "active",
          "datasource": { "type": "prometheus", "uid": "prom" }
        },
        {
          "expr": "hikaricp_connections",
          "legendFormat": "total",
          "datasource": { "type": "prometheus", "uid": "prom" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB wait (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(hikaricp_connections_acquire_seconds_sum[1m]) / rate(hikaricp_connections_acquire_seconds_count[1m])",
          "legendFormat": "avg acquire time",
          "datasource": { "type": "prometheus", "uid": "prom" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used vs max (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "heap used",
          "datasource": { "type": "prometheus", "uid": "prom" }
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "heap max",
          "datasource": { "type": "prometheus", "uid": "prom" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC pauses (s/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[5m])",
          "legendFormat": "gc pause rate",
          "datasource": { "type": "prometheus", "uid": "prom" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Threads live / daemon",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "legendFormat": "live",
          "datasource": { "type": "prometheus", "uid": "prom" }
        },
        {
          "expr": "jvm_threads_daemon_threads",
          "legendFormat": "daemon",
          "datasource": { "type": "prometheus", "uid": "prom" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU (process / system)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "process_cpu_usage",
          "legendFormat": "process",
          "datasource": { "type": "prometheus", "uid": "prom" }
        },
        {
          "expr": "system_cpu_usage",
          "legendFormat": "system",
          "datasource": { "type": "prometheus", "uid": "prom" }
        }
      ]
    }
  ]
}